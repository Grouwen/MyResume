# web相关
WEB_HOST=127.0.0.1
WEB_PORT=20056

# tavily相关
TAVILY_API_KEY=去https://www.tavily.com/获取key，填在这里
TAVILY_EXTRACT_DEPTH=basic

# postgresql相关
POSTGRESQL_URL=postgresql+psycopg://用户名:密码@127.0.0.1:5432/数据库名称
POSTGRESQL_POOL_MIN_SIZE=2
POSTGRESQL_POOL_MAX_SIZE=10
POSTGRESQL_ECHO=True

# jwt相关
JWT_SECRET_KEY=jwt密钥
JWT_ACCESS_TOKEN_EXPIRE_DAYS=7

# checkpoint相关
CHECKPOINT_BACKEND=postgres
CHECKPOINT_SETUP_ON_STARTUP=True
CHECKPOINT_POOL_MIN_SIZE=1
CHECKPOINT_POOL_MAX_SIZE=2